# Reference Nginx server block for this site. Copy onto the VPS (typically
# /etc/nginx/sites-available/veltech), adjust server_name and root, then
# `nginx -t && systemctl reload nginx`.
#
# Two things here matter, and skipping either one breaks something quietly.

server {
    listen 80;
    listen [::]:80;
    server_name veltera.cloud www.veltera.cloud;

    # Point this at the contents of `dist/` produced by `npm run build`.
    root /var/www/veltech/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---------------------------------------------------------------------
    # 1. SPA fallback.
    #
    # vue-router runs in HTML5 history mode, so /pricing and
    # /services/custom-systems-erp are routes the client resolves — there are
    # no such directories on disk. Without this line, clicking through from
    # the home page works (that never touches the server) while opening
    # /pricing directly, refreshing on it, or following a shared pricing link
    # returns 404. The pricing pages are meant to be linked to, so that last
    # case matters most.
    # ---------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------------------------------------------------------------------
    # 2. Cache the hashed assets hard, never cache index.html.
    #
    # Vite fingerprints every file in /assets (index-a1b2c3d4.js), so those
    # are safe to cache forever — a new build produces new filenames.
    # index.html is the opposite: it is the file that names which bundle to
    # load, so if a browser holds a cached copy it keeps loading the OLD
    # build after a deploy. That is a common way for a fix to appear "not
    # deployed" on a phone that visited the site before, while a fresh device
    # sees it immediately.
    # ---------------------------------------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location = /og-image.jpg {
        expires 7d;
        add_header Cache-Control "public";
    }
}
