# Apache equivalent of deploy/nginx.conf.example — use this instead if the
# VPS runs Apache rather than Nginx. Copy to the document root as `.htaccess`
# (requires AllowOverride All for that directory).

# --- SPA fallback -----------------------------------------------------------
# vue-router uses HTML5 history mode, so /pricing and /services/:slug are
# client-side routes with no matching directory on disk. Without this, opening
# or refreshing one directly — including any pricing link shared with a
# client — returns 404, even though clicking through from the home page works.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Serve the per-route static file first. The build emits pricing.html,
  # services/ai-data.html and so on, each carrying that route's real title,
  # description and canonical — the first-pass crawl does not run JavaScript,
  # so without this every URL would serve the home page's metadata.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching ----------------------------------------------------------------
# Vite fingerprints everything in /assets, so those can be cached forever.
# index.html must NOT be cached: it names which bundle to load, so a stale copy
# keeps serving the previous build after a deploy — which looks like the deploy
# never happened, on that device only.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
